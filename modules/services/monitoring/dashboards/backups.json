{
  "uid": "mipnix-backups",
  "title": "Backups",
  "schemaVersion": 39,
  "time": { "from": "now-7d", "to": "now" },
  "refresh": "5m",
  "panels": [
    {
      "type": "stat",
      "title": "Failed backup and sync units",
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "count(node_systemd_unit_state{name=~\".*\\\\.service\", state=\"failed\"} == 1) or vector(0)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "Hosts reporting",
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(up{job=\"node\"})", "instant": true }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "Hosts down",
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "count(up{job=\"node\"} == 0) or vector(0)", "instant": true }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "table",
      "title": "Unit state",
      "gridPos": { "h": 12, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "node_systemd_unit_state{name=~\".*\\\\.service\"} == 1",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "Value": true, "__name__": true, "job": true, "type": true },
            "renameByName": { "instance": "Host", "name": "Unit", "state": "State" }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "State" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-background" } },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "failed": { "color": "red", "index": 0 },
                      "active": { "color": "blue", "index": 1 },
                      "activating": { "color": "blue", "index": 2 },
                      "inactive": { "color": "green", "index": 3 }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": { "sortBy": [{ "displayName": "Host" }] }
    },
    {
      "type": "table",
      "title": "Time since timer last fired",
      "gridPos": { "h": 12, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - node_systemd_timer_last_trigger_seconds",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "job": true },
            "renameByName": { "instance": "Host", "name": "Timer", "Value": "Since last run" }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 90000 },
              { "color": "red", "value": 129600 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Since last run" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-text" } }
            ]
          }
        ]
      },
      "options": { "sortBy": [{ "displayName": "Since last run", "desc": true }] }
    }
  ]
}
