      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 4,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "failed",
          "expr": "count(node_systemd_unit_state{name=~\"(restic-backups-.*|hip-repo-backup)\\\\.service\",state=\"failed\"} == 1) or vector(0)",
          "instant": true,
          "legendFormat": "failed"
        },
        {
          "refId": "stale",
          "expr": "count((time() - node_systemd_timer_last_trigger_seconds{name=~\"(restic-backups-.*|hip-repo-backup)\\\\.timer\"}) > 93600 and node_systemd_timer_last_trigger_seconds{name=~\"(restic-backups-.*|hip-repo-backup)\\\\.timer\"} > 0) or vector(0)",
