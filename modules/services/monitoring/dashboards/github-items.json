    {
      "type": "stat",
      "title": "Awaiting your review",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 10,
        "y": 0
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "github-stats"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "github-stats"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) FROM items i JOIN repos r ON r.id = i.repo_id WHERE r.account IN ($account) AND ('$author' = 'all' OR i.author_type = '$author') AND i.review_requested AND i.closed_at IS NULL"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false,
          "fields": ""
        }
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Median time to merge",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 14,
        "y": 0
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "github-stats"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "github-stats"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT percentile_cont(0.5) WITHIN GROUP (ORDER BY extract(epoch FROM i.merged_at - i.created_at)) FROM items i JOIN repos r ON r.id = i.repo_id WHERE r.account IN ($account) AND ('$author' = 'all' OR i.author_type = '$author') AND $__timeFilter(i.merged_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false,
          "fields": ""
        }
      },
      "id": 4
    },
    {
      "type": "stat",
      "title": "Median first response",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 19,
        "y": 0
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "github-stats"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "github-stats"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT percentile_cont(0.5) WITHIN GROUP (ORDER BY extract(epoch FROM i.first_response_at - i.created_at)) FROM items i JOIN repos r ON r.id = i.repo_id WHERE r.account IN ($account) AND ('$author' = 'all' OR i.author_type = '$author') AND i.author_type <> 'owner' AND $__timeFilter(i.created_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false,
          "fields": ""
        }
      },
      "id": 5
    },
    {
      "type": "stat",
      "title": "Stale",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "github-stats"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "github-stats"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) FROM items i JOIN repos r ON r.id = i.repo_id WHERE r.account IN ($account) AND ('$author' = 'all' OR i.author_type = '$author') AND i.closed_at IS NULL AND i.updated_at < now() - interval '$stale days'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false,
          "fields": ""
        }
      },
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "PRs + issues opened vs. closed per week",
      "gridPos": {
        "h": 9,
        "w": 14,
        "x": 0,
        "y": 7
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "github-stats"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "github-stats"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "\nSELECT w AS time,\n  (SELECT count(*) FROM items i JOIN repos r ON r.id = i.repo_id WHERE r.account IN ($account) AND ('$author' = 'all' OR i.author_type = '$author') AND date_trunc('week', i.created_at) = w) AS \"Opened\",\n  (SELECT count(*) FROM items i JOIN repos r ON r.id = i.repo_id WHERE r.account IN ($account) AND ('$author' = 'all' OR i.author_type = '$author') AND date_trunc('week', i.closed_at) = w) AS \"Closed / merged\"\nFROM generate_series(date_trunc('week', $__timeFrom()::timestamptz), $__timeTo()::timestamptz, interval '1 week') AS w\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 2,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 7
    },
    {
      "type": "barchart",
      "title": "Open issues + PRs by account",
      "gridPos": {
        "h": 9,
        "w": 10,
        "x": 14,
        "y": 7
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "github-stats"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "github-stats"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "\nSELECT r.account,\n  count(*) FILTER (WHERE i.kind = 'issue') AS \"Issues\",\n  count(*) FILTER (WHERE i.kind = 'pr') AS \"PRs\"\nFROM items i JOIN repos r ON r.id = i.repo_id WHERE r.account IN ($account) AND ('$author' = 'all' OR i.author_type = '$author') AND i.closed_at IS NULL\nGROUP BY 1 ORDER BY count(*) DESC LIMIT 10"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 80
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "stacking": "normal",
        "showValue": "auto",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "id": 8
    },
    {
      "type": "table",
      "title": "Needs attention - oldest without a response",
      "gridPos": {
        "h": 11,
        "w": 14,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "github-stats"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "github-stats"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "\nSELECT i.kind AS type, i.title, r.account || '/' || r.name AS repository, i.author_type AS author,\n  extract(epoch FROM now() - i.created_at) AS waiting, i.url\nFROM items i JOIN repos r ON r.id = i.repo_id WHERE r.account IN ($account) AND ('$author' = 'all' OR i.author_type = '$author') AND i.closed_at IS NULL AND i.author_type <> 'owner' AND i.first_response_at IS NULL\nORDER BY i.created_at LIMIT 25"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "title"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open",
                    "url": "${__data.fields.url}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "waiting"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "url"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 9
    },
    {
      "type": "bargauge",
      "title": "Open issue age",
      "gridPos": {
        "h": 6,
        "w": 10,
        "x": 14,
        "y": 16
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "github-stats"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "github-stats"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "\nSELECT bucket, count(*) AS items FROM (\n  SELECT CASE\n    WHEN now() - i.created_at < interval '7 days' THEN 1\n    WHEN now() - i.created_at < interval '30 days' THEN 2\n    WHEN now() - i.created_at < interval '90 days' THEN 3\n    WHEN now() - i.created_at < interval '1 year' THEN 4\n    ELSE 5 END AS n\n  FROM items i JOIN repos r ON r.id = i.repo_id WHERE r.account IN ($account) AND ('$author' = 'all' OR i.author_type = '$author') AND i.kind = 'issue' AND i.closed_at IS NULL\n) a\nJOIN (VALUES (1, '< 7 d'), (2, '7-30 d'), (3, '30-90 d'), (4, '90 d - 1 y'), (5, '> 1 y')) AS b(n, bucket) USING (n)\nGROUP BY n, bucket ORDER BY n"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": true,
          "fields": ""
        }
      },
      "id": 10
    },
    {
      "type": "piechart",
      "title": "Merged PRs by author type",
      "gridPos": {
        "h": 5,
        "w": 10,
        "x": 14,
        "y": 22
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "github-stats"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "github-stats"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT i.author_type AS author, count(*) AS prs FROM items i JOIN repos r ON r.id = i.repo_id WHERE r.account IN ($account) AND ('$author' = 'all' OR i.author_type = '$author') AND i.kind = 'pr' AND $__timeFilter(i.merged_at) GROUP BY 1 ORDER BY 2 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "pieType": "donut",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": true,
          "fields": ""
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "percent"
          ]
        }
      },
      "id": 11
    }
  ]
}
