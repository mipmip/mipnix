      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "github-stats"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) FROM items i JOIN repos r ON r.id = i.repo_id WHERE r.account IN ($account) AND ('$author' = 'all' OR i.author_type = '$author') AND i.kind = 'issue' AND i.closed_at IS NULL"
        }
      ],
      "fieldConfig": {
