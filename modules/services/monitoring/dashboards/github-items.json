  "templating": {
    "list": [
      {
        "type": "query",
        "name": "account",
        "label": "Account",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "github-stats"
        },
        "query": "SELECT DISTINCT account FROM repos ORDER BY 1",
        "definition": "SELECT DISTINCT account FROM repos ORDER BY 1",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 0
      },
      {
        "type": "custom",
        "name": "author",
        "label": "Author",
        "query": "Everyone : all,External : external,Me : owner,Bots : bot",
        "current": {
          "text": "Everyone",
          "value": "all"
        },
        "options": [
          {
            "text": "Everyone",
            "value": "all",
            "selected": true
          },
          {
            "text": "External",
            "value": "external",
            "selected": false
          },
          {
            "text": "Me",
            "value": "owner",
            "selected": false
          },
          {
            "text": "Bots",
            "value": "bot",
            "selected": false
          }
        ]
      },
      {
        "type": "custom",
        "name": "stale",
        "label": "Stale after",
        "query": "90 days : 90,30 days : 30,180 days : 180",
        "current": {
          "text": "90 days",
          "value": "90"
        },
        "options": [
          {
            "text": "90 days",
            "value": "90",
            "selected": true
