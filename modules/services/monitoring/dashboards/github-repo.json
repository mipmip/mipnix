    {
      "type": "timeseries",
      "title": "Star history",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "github-stats"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "github-stats"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "\nWITH s AS (\n  SELECT s.starred_at FROM stargazers s JOIN repos r ON r.id = s.repo_id WHERE r.account = '$account' AND r.name = '$repo'\n)\nSELECT d AS time, (SELECT count(*) FROM s WHERE s.starred_at < d + interval '1 day') AS \"Total stars\"\nFROM generate_series(date_trunc('day', $__timeFrom()::timestamptz), $__timeTo()::timestamptz, interval '1 day') AS d\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 30,
            "lineWidth": 2,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "New stars per month",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "github-stats"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "github-stats"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "\nSELECT date_trunc('month', s.starred_at) AS time, count(*) AS \"New stars\"\nFROM stargazers s JOIN repos r ON r.id = s.repo_id\nWHERE r.account = '$account' AND r.name = '$repo' AND $__timeFilter(s.starred_at)\nGROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 2,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 8
    },
    {
      "type": "table",
      "title": "Open issues & pull requests",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "github-stats"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "github-stats"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "\nSELECT i.kind AS type, i.title, array_to_string(i.labels, ', ') AS labels, i.comments,\n  extract(epoch FROM now() - i.created_at) AS opened, i.url\nFROM items i JOIN repos r ON r.id = i.repo_id\nWHERE r.account = '$account' AND r.name = '$repo' AND i.closed_at IS NULL\nORDER BY i.created_at DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "title"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open",
                    "url": "${__data.fields.url}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "opened"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "url"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 9
    }
