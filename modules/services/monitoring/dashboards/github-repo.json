          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT extract(epoch FROM pushed_at) * 1000 FROM repos r WHERE r.account = '$account' AND r.name = '$repo'"
        }
      ],
      "fieldConfig": {
        "defaults": {
