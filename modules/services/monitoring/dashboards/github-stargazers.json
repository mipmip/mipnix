{
  "uid": "github-stargazers",
  "title": "Stargazers overview",
  "tags": [
    "github"
  ],
  "schemaVersion": 39,
  "time": {
    "from": "now-1y",
    "to": "now"
  },
  "refresh": "",
  "links": [
    {
      "title": "Stargazers",
      "type": "link",
      "url": "/d/github-stargazers"
    },
    {
      "title": "PRs & issues",
      "type": "link",
      "url": "/d/github-items"
    },
    {
      "title": "Repo drill-down",
      "type": "link",
      "url": "/d/github-repo"
    }
  ],
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "account",
        "label": "Account",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "github-stats"
        },
        "query": "SELECT DISTINCT account FROM repos ORDER BY 1",
        "definition": "SELECT DISTINCT account FROM repos ORDER BY 1",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 0
      },
      {
        "type": "custom",
        "name": "scope",
        "label": "Visibility",
        "query": "Public, not forks/archived : active,All public : all",
        "current": {
          "text": "Public, not forks/archived",
          "value": "active"
        },
        "options": [
          {
            "text": "Public, not forks/archived",
            "value": "active",
            "selected": true
          },
          {
            "text": "All public",
            "value": "all",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Total stars",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "github-stats"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "github-stats"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT coalesce(sum(stars), 0) FROM repos r WHERE r.account IN ($account) AND ('$scope' = 'all' OR (NOT r.is_fork AND NOT r.is_archived))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false,
          "fields": ""
        }
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Stars gained - 30 days",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 5,
        "y": 0
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "github-stats"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "github-stats"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) FROM stargazers s JOIN repos r ON r.id = s.repo_id WHERE r.account IN ($account) AND ('$scope' = 'all' OR (NOT r.is_fork AND NOT r.is_archived)) AND s.starred_at > now() - interval '30 days'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false,
          "fields": ""
        }
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Repositories",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 10,
        "y": 0
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "github-stats"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "github-stats"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) FROM repos r WHERE r.account IN ($account) AND ('$scope' = 'all' OR (NOT r.is_fork AND NOT r.is_archived))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false,
          "fields": ""
        }
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Organizations",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 14,
        "y": 0
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "github-stats"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "github-stats"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(DISTINCT account) FILTER (WHERE account <> 'mipmip') FROM repos r WHERE r.account IN ($account)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false,
          "fields": ""
        }
      },
      "id": 4
    },
    {
      "type": "stat",
      "title": "Most-starred repo",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "github-stats"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "github-stats"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT r.account || '/' || r.name || ' (' || r.stars || ')' AS repo FROM repos r WHERE r.account IN ($account) AND ('$scope' = 'all' OR (NOT r.is_fork AND NOT r.is_archived)) ORDER BY r.stars DESC LIMIT 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": true,
          "fields": ""
        }
      },
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Cumulative stars - all accounts",
      "gridPos": {
        "h": 9,
        "w": 14,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "github-stats"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "github-stats"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "\nWITH s AS (\n  SELECT s.starred_at FROM stargazers s JOIN repos r ON r.id = s.repo_id WHERE r.account IN ($account) AND ('$scope' = 'all' OR (NOT r.is_fork AND NOT r.is_archived))\n)\nSELECT d AS time, (SELECT count(*) FROM s WHERE s.starred_at < d + interval '1 day') AS \"Total stars\"\nFROM generate_series(date_trunc('day', $__timeFrom()::timestamptz), $__timeTo()::timestamptz, interval '1 day') AS d\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 2,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 6
    },
    {
      "type": "bargauge",
      "title": "Stars per account",
      "gridPos": {
        "h": 9,
        "w": 10,
        "x": 14,
        "y": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "github-stats"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "github-stats"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT r.account, sum(r.stars) AS stars FROM repos r WHERE r.account IN ($account) AND ('$scope' = 'all' OR (NOT r.is_fork AND NOT r.is_archived)) GROUP BY 1 HAVING sum(r.stars) > 0 ORDER BY 2 DESC LIMIT 12"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": true,
          "fields": ""
        }
      },
      "id": 7
    },
    {
      "type": "table",
      "title": "Top repositories by stars",
      "gridPos": {
        "h": 10,
        "w": 14,
        "x": 0,
        "y": 13
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "github-stats"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "github-stats"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT r.name AS repository, r.account, r.stars FROM repos r WHERE r.account IN ($account) AND ('$scope' = 'all' OR (NOT r.is_fork AND NOT r.is_archived)) ORDER BY r.stars DESC LIMIT 15"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "repository"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open",
                    "url": "/d/github-repo?var-account=${__data.fields.account}&var-repo=${__data.fields.repository}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "url"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 8
    },
    {
      "type": "piechart",
      "title": "Share of stars",
      "gridPos": {
        "h": 10,
        "w": 10,
        "x": 14,
        "y": 13
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "github-stats"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "github-stats"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "\nWITH a AS (SELECT r.account, sum(r.stars) AS stars FROM repos r WHERE r.account IN ($account) AND ('$scope' = 'all' OR (NOT r.is_fork AND NOT r.is_archived)) GROUP BY 1),\nranked AS (SELECT account, stars, row_number() OVER (ORDER BY stars DESC) AS n FROM a)\nSELECT CASE WHEN n <= 5 THEN account ELSE 'Others' END AS account, sum(stars) AS stars\nFROM ranked GROUP BY 1 ORDER BY 2 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "pieType": "donut",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": true,
          "fields": ""
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "percent"
          ]
        }
      },
      "id": 9
    }
  ]
}
