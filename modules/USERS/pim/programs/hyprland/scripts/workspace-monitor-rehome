#!/usr/bin/env bash
# workspace-monitor-rehome: keep external workspaces on the external monitor.
#
# The external monitor is a different physical display on a different port at
# home vs. work, so it enumerates as DP-2 or DP-3. A static connector pin in
# workspaces.conf therefore cannot be correct — a dead-connector rule strands
# workspaces 1-7 on the laptop. The only stable predicate is "the monitor that
# is NOT the laptop panel eDP-1", which can only be resolved at runtime. So
# workspaces.conf carries NO monitor pin for 1-7 and this script is the SOLE
# owner of their binding.
#
# workspaces.conf is a repo-owned, immutable (nix-store) config — nwg-displays
# does NOT rewrite it at runtime. nwg-displays owns monitor GEOMETRY
# (monitors.conf) only.
#
# Reconcile runs at startup, on monitor add/remove, AND on workspace
# focus/create (because with no static pin a fresh 1-7 workspace binds to the
# focused monitor first, which may be the laptop). A debounce guards against the
# reconcile's own moveworkspacetomonitor dispatches re-triggering it into a loop.
#
# Mapping:
#   workspaces 1-7  -> the connected external monitor (first non-eDP-1), if any
#   workspaces 8/9/0 -> always the laptop panel eDP-1

set -u

LAPTOP="eDP-1"
EXTERNAL_WS="1 2 3 4 5 6 7"
LAPTOP_WS="8 9 0"

# Pick the external monitor name: first connected monitor that is not the laptop.
# Empty string if only the laptop is connected.
external_monitor() {
  hyprctl monitors -j 2>/dev/null \
    | jq -r --arg laptop "$LAPTOP" \
        'map(select(.name != $laptop)) | .[0].name // empty'
}

monitor_connected() {
  hyprctl monitors -j 2>/dev/null | jq -e --arg n "$1" 'any(.name == $n)' >/dev/null 2>&1
}

reconcile() {
  local ext laptop_present
  ext="$(external_monitor)"

  if monitor_connected "$LAPTOP"; then
    laptop_present=1
  else
    laptop_present=0
  fi

  if [ -n "$ext" ]; then
    # External present: 1-7 -> external, 8/9/0 -> laptop (if laptop present).
    for ws in $EXTERNAL_WS; do
      hyprctl dispatch moveworkspacetomonitor "$ws $ext" >/dev/null 2>&1
    done
    if [ "$laptop_present" = "1" ]; then
      for ws in $LAPTOP_WS; do
        hyprctl dispatch moveworkspacetomonitor "$ws $LAPTOP" >/dev/null 2>&1
      done
    fi
  else
    # No external: everything falls back to the laptop panel.
    if [ "$laptop_present" = "1" ]; then
      for ws in $EXTERNAL_WS $LAPTOP_WS; do
        hyprctl dispatch moveworkspacetomonitor "$ws $LAPTOP" >/dev/null 2>&1
      done
    fi
  fi
}

# 1. Initial reconciliation (handles monitors already connected at login).
reconcile

# 2. Listen for monitor add/remove events and reconcile on each.
SOCK="$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock"
if [ ! -S "$SOCK" ]; then
  echo "workspace-monitor-rehome: socket2 not found at $SOCK" >&2
  exit 1
fi

# Debounce for workspace-triggered reconciles: reconcile dispatches
# moveworkspacetomonitor, which itself emits workspace/focusedmon events. Without
# a guard those would re-enter this loop and could storm. We suppress workspace-
# triggered reconciles that arrive within DEBOUNCE_MS of the last one. Monitor
# add/remove events are rarer and important, so they always reconcile (and reset
# the debounce clock). now_ms/last are plain vars — the whole `while` runs in one
# pipeline subshell, so they persist across iterations.
DEBOUNCE_MS=400
last_ms=0
now_ms() { echo $(( $(date +%s%N) / 1000000 )); }

socat -U - "UNIX-CONNECT:$SOCK" 2>/dev/null | while read -r line; do
  case "$line" in
    monitoradded*|monitorremoved*)
      # Monitor topology changed: brief settle so hyprctl monitors reflects it.
      sleep 0.3
      reconcile
      last_ms="$(now_ms)"
      ;;
    workspace\>\>*|workspacev2\>\>*|createworkspace\>\>*|createworkspacev2\>\>*|focusedmon\>\>*|focusedmonv2\>\>*)
      # A 1-7 workspace may have just bound to the focused (possibly laptop)
      # monitor; pull it back to the external one. No settle delay here (no
      # topology change) so the correction is near-instant. Debounced so the
      # reconcile's own emitted events don't re-trigger it.
      cur_ms="$(now_ms)"
      if [ "$(( cur_ms - last_ms ))" -ge "$DEBOUNCE_MS" ]; then
        reconcile
        last_ms="$(now_ms)"
      fi
      ;;
  esac
done
