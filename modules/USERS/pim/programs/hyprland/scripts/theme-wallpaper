#!/usr/bin/env bash
# Switch wpaperd wallpaper path based on theme mode using symlinks
# Usage: theme-wallpaper dark|light|init
#
# Since Nix makes ~/.config/wpaperd/config.toml immutable, we use a symlink
# at ~/.cache/wallpapers-current that points to the appropriate wallpaper dir.
# wpaperd config points to this symlink.

set -euo pipefail

MODE="${1:-}"
WALLPAPER_BASE="$HOME/mipnix/resources"
SYMLINK_PATH="$HOME/.cache/wallpapers-current"

if [[ -z "$MODE" ]]; then
    echo "Usage: theme-wallpaper dark|light|init" >&2
    exit 1
fi

# Resolve the effective dark/light mode
case "$MODE" in
    dark|light)
        EFFECTIVE="$MODE"
        ;;
    init)
        # Initialize based on current gsettings color-scheme
        CURRENT_SCHEME=$(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null || echo "'prefer-dark'")
        if [[ "$CURRENT_SCHEME" == *"light"* ]]; then
            EFFECTIVE="light"
        else
            EFFECTIVE="dark"
        fi
        ;;
    *)
        echo "Invalid mode: $MODE. Use 'dark', 'light', or 'init'." >&2
        exit 1
        ;;
esac

# Host-wallpaper precedence (openspec add-host-wallpaper): a per-host image
# replaces the shared theme dir on hosts where mip.hostWallpaper is in use.
# Order: committed (resources/host-wallpapers) > downloaded > shared theme dir.
# wpaperd needs a directory, so stage the chosen image alone in an active dir.
HOST="$(hostname -s 2>/dev/null || cat /etc/hostname 2>/dev/null || echo unknown)"
COMMITTED="$HOME/mipnix/resources/host-wallpapers/$HOST-$EFFECTIVE.jpg"
DOWNLOADED="$HOME/.local/share/host-wallpaper/$EFFECTIVE/$HOST-$EFFECTIVE.jpg"
ACTIVE_DIR="$HOME/.cache/host-wallpaper/$EFFECTIVE"

HOST_IMG=""
if [[ -f "$COMMITTED" ]]; then
    HOST_IMG="$COMMITTED"
elif [[ -f "$DOWNLOADED" ]]; then
    HOST_IMG="$DOWNLOADED"
fi

if [[ -n "$HOST_IMG" ]]; then
    mkdir -p "$ACTIVE_DIR"
    rm -f "$ACTIVE_DIR"/* 2>/dev/null || true
    ln -sf "$HOST_IMG" "$ACTIVE_DIR/$HOST-$EFFECTIVE.jpg"
    TARGET="$ACTIVE_DIR"
else
    # Fallback: shared theme wallpapers (original behavior)
    TARGET="$WALLPAPER_BASE/wallpapers-$EFFECTIVE"
fi

# Ensure cache directory exists
mkdir -p "$(dirname "$SYMLINK_PATH")"

# Update symlink (remove old one first if exists)
rm -f "$SYMLINK_PATH"
ln -s "$TARGET" "$SYMLINK_PATH"

# Reload wpaperd to apply changes
pkill -USR2 wpaperd 2>/dev/null || true
hyprctl dispatch exec "wpaperd -d"
