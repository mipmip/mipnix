#!/usr/bin/env python3
"""
hypr-longpress: Long-press LMB to open a window action menu.

Parses libinput debug-events for button press/release and pointer motion,
detects a 2-second left-click hold with minimal cursor movement (<5px),
then spawns a rofi context menu with window management actions dispatched
via hyprctl.
"""

import asyncio
import json
import logging
import math
import re
import subprocess
import sys

HOLD_DURATION = 2.0  # seconds
DEADZONE_PX = 5  # pixels

ACTIONS = [
    "Close",
    "Fullscreen",
    "Float",
    "Minimize",
    "Pin",
    *[f"Move to WS {i}" for i in range(1, 11)],
]

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s [hypr-longpress] %(message)s",
)
log = logging.getLogger(__name__)

# libinput debug-events patterns
# POINTER_BUTTON: " event13  POINTER_BUTTON           +2.456s	BTN_LEFT (272) pressed, seat count: 1"
RE_BUTTON = re.compile(r"POINTER_BUTTON\s+.*BTN_LEFT\s+\(\d+\)\s+(pressed|released)")
# POINTER_MOTION: " event13  POINTER_MOTION           +0.018s	 -0.78/  3.12 ( -1.00/ +4.00)"
RE_MOTION = re.compile(r"POINTER_MOTION\s+.*\(\s*([+-]?[\d.]+)/\s*([+-]?[\d.]+)\)")


def hyprctl_json(command):
    """Run a hyprctl command and return parsed JSON."""
    result = subprocess.run(
        ["hyprctl", command, "-j"],
        capture_output=True,
        text=True,
    )
    return json.loads(result.stdout)


def get_cursor_pos():
    """Get cursor position in global layout coordinates."""
    pos = hyprctl_json("cursorpos")
    return pos["x"], pos["y"]


def get_active_window():
    """Get the active window address."""
    win = hyprctl_json("activewindow")
    return win.get("address", "")


def get_screen_relative_pos(global_x, global_y):
    """Convert global layout coordinates to screen-relative coordinates for rofi."""
    monitors = hyprctl_json("monitors")
    for mon in monitors:
        mx, my = mon["x"], mon["y"]
        mw, mh = mon["width"], mon["height"]
        scale = mon.get("scale", 1.0)
        scaled_w = mw / scale
        scaled_h = mh / scale
        if mx <= global_x < mx + scaled_w and my <= global_y < my + scaled_h:
            return int(global_x - mx), int(global_y - my)
    return int(global_x), int(global_y)


def dispatch_action(selection, window_addr):
    """Map a menu selection to a hyprctl dispatch command."""
    if not selection or not window_addr:
        log.warning("dispatch_action called with empty selection=%r or window_addr=%r", selection, window_addr)
        return

    addr = f"address:{window_addr}"
    log.info("Dispatching action=%r to %s", selection, addr)

    def run_hyprctl(*args):
        result = subprocess.run(["hyprctl", *args], capture_output=True, text=True)
        log.info("hyprctl %s -> stdout=%r stderr=%r", " ".join(args), result.stdout.strip(), result.stderr.strip())
        return result

    if selection == "Close":
        run_hyprctl("dispatch", "closewindow", addr)
    elif selection == "Fullscreen":
        run_hyprctl("dispatch", "focuswindow", addr)
        run_hyprctl("dispatch", "fullscreen", "1")
    elif selection == "Float":
        run_hyprctl("dispatch", "focuswindow", addr)
        run_hyprctl("dispatch", "togglefloating", addr)
    elif selection == "Minimize":
        run_hyprctl("dispatch", "movetoworkspacesilent", f"special:minimized,{addr}")
    elif selection == "Pin":
        run_hyprctl("dispatch", "focuswindow", addr)
        run_hyprctl("dispatch", "pin", addr)
    elif selection.startswith("Move to WS "):
        ws = selection.split()[-1]
        run_hyprctl("dispatch", "movetoworkspace", f"{ws},{addr}")


def show_menu(screen_x, screen_y):
    """Show rofi dmenu at the given screen-relative position and return the selection."""
    menu_input = "\n".join(ACTIONS)
    try:
        result = subprocess.run(
            [
                "rofi",
                "-dmenu",
                "-p", "Window",
                "-theme-str", f"window {{ location: northwest; x-offset: {screen_x}px; y-offset: {screen_y}px; }}",
                "-theme-str", "listview { lines: 15; }",
                "-theme-str", "window { width: 200px; }",
            ],
            input=menu_input,
            capture_output=True,
            text=True,
            timeout=10,
        )
        log.info("rofi exit code: %d, stdout: %r, stderr: %r", result.returncode, result.stdout.strip(), result.stderr.strip())
        return result.stdout.strip()
    except subprocess.TimeoutExpired:
        return ""


class LongPressDetector:
    def __init__(self):
        self.pressed = False
        self.cumulative_dx = 0.0
        self.cumulative_dy = 0.0
        self.timer_task = None
        self.menu_active = False

    def cancel_timer(self):
        if self.timer_task and not self.timer_task.done():
            self.timer_task.cancel()
            self.timer_task = None

    async def on_trigger(self):
        """Called when long-press hold completes."""
        if self.menu_active:
            return

        self.menu_active = True
        try:
            window_addr = get_active_window()
            if not window_addr:
                log.info("No active window, skipping menu")
                return

            global_x, global_y = get_cursor_pos()
            screen_x, screen_y = get_screen_relative_pos(global_x, global_y)

            log.info("Long-press detected at (%d, %d), showing menu", screen_x, screen_y)

            loop = asyncio.get_event_loop()
            selection = await loop.run_in_executor(None, show_menu, screen_x, screen_y)

            if selection:
                log.info("Selected: %s for window %s", selection, window_addr)
                try:
                    await loop.run_in_executor(None, dispatch_action, selection, window_addr)
                except Exception as e:
                    log.error("dispatch_action failed: %s", e)
            else:
                log.info("Menu dismissed")
        except Exception as e:
            log.error("on_trigger error: %s", e, exc_info=True)
        finally:
            self.menu_active = False

    async def hold_timer(self):
        """Wait for HOLD_DURATION then trigger the menu."""
        await asyncio.sleep(HOLD_DURATION)
        # Clear timer_task before triggering, so button_up can't cancel
        # the on_trigger execution mid-flight
        self.timer_task = None
        await self.on_trigger()

    def on_button_down(self):
        log.debug("BTN_LEFT pressed")
        if self.menu_active:
            return
        self.pressed = True
        self.cumulative_dx = 0.0
        self.cumulative_dy = 0.0
        self.cancel_timer()
        self.timer_task = asyncio.ensure_future(self.hold_timer())

    def on_button_up(self):
        log.debug("BTN_LEFT released")
        self.pressed = False
        self.cancel_timer()

    def on_motion(self, dx, dy):
        if not self.pressed:
            return
        self.cumulative_dx += dx
        self.cumulative_dy += dy
        dist = math.hypot(self.cumulative_dx, self.cumulative_dy)
        if dist > DEADZONE_PX:
            log.debug("Movement exceeded deadzone (%.1fpx), cancelling", dist)
            self.cancel_timer()


async def main():
    detector = LongPressDetector()

    proc = await asyncio.create_subprocess_exec(
        "libinput", "debug-events",
        stdout=asyncio.subprocess.PIPE,
        stderr=asyncio.subprocess.DEVNULL,
    )

    import os
    log.info("HYPRLAND_INSTANCE_SIGNATURE=%s", os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "NOT SET"))
    log.info("Listening via libinput debug-events (pid %d)", proc.pid)

    async for line_bytes in proc.stdout:
        line = line_bytes.decode("utf-8", errors="replace")

        m = RE_BUTTON.search(line)
        if m:
            if m.group(1) == "pressed":
                detector.on_button_down()
            else:
                detector.on_button_up()
            continue

        m = RE_MOTION.search(line)
        if m:
            dx, dy = float(m.group(1)), float(m.group(2))
            detector.on_motion(dx, dy)

    rc = await proc.wait()
    if rc != 0:
        log.error("libinput debug-events exited with code %d", rc)
        log.error("Ensure your user is in the 'input' group and libinput is installed")
        sys.exit(1)


if __name__ == "__main__":
    asyncio.run(main())
